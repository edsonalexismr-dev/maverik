{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-collect",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron-analyze",
      "schedule": "0 */12 * * *"
    }
  ]
}
